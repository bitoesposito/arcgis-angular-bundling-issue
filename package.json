{
  "name": "webpack-build",
  "version": "1.0.0",
  "scripts": {
    "dev": "ng serve",
    "build:esbuild": "ng build",
    "build:webpack": "ng run app:build-webpack:production",
    "build:all": "npm run build:esbuild && npm run build:webpack",
    "serve:esbuild": "serve dist/app/browser -l 4201 -s",
    "serve:webpack": "serve dist-webpack -l 4202 -s",
    "docker:dev": "docker compose --project-directory . -f .docker/docker-compose.dev.yml up --build",
    "docker:prod": "docker compose --project-directory . -f .docker/docker-compose.prod.yml up --build",
    "docker:prod-esbuild": "docker compose --project-directory . -f .docker/docker-compose.prod-esbuild.yml up --build",
    "docker:prod-webpack": "docker compose --project-directory . -f .docker/docker-compose.prod-webpack.yml up --build"
  },
  "dependencies": {
    "@angular/animations": "20.0.3",
    "@angular/common": "20.0.3",
    "@angular/compiler": "20.0.3",
    "@angular/core": "20.0.3",
    "@angular/forms": "20.0.3",
    "@angular/platform-browser": "20.0.3",
    "@angular/platform-browser-dynamic": "20.0.3",
    "@angular/router": "20.0.3",
    "@arcgis/core": "4.34",
    "@arcgis/map-components": "4.34",
    "@esri/arcgis-rest-demographics": "4.0.3",
    "@esri/calcite-components": "3.3.3",
    "@mapbox/shp-write": "0.4.3",
    "@ngneat/elf": "2.5.1",
    "@ngneat/elf-devtools": "1.3.0",
    "@tmcw/togeojson": "7.1.2",
    "@types/bootstrap": "5.2.10",
    "dotenv": "16.5.0",
    "jquery": "3.7.1",
    "react": "19.1.0",
    "rxjs": "^7.8.2",
    "shpjs": "^6.2.0",
    "zone.js": "0.15.1"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^20.0.0",
    "@angular-devkit/build-angular": "20.0.2",
    "@angular/build": "20.0.3",
    "@angular/cli": "^20.0.3",
    "@angular/compiler-cli": "20.0.3",
    "@babel/cli": "7.27.2",
    "@babel/core": "7.27.4",
    "@babel/plugin-proposal-decorators": "7.27.1",
    "@babel/preset-env": "7.27.2",
    "@babel/preset-typescript": "7.27.1",
    "@types/jquery": "3.5.32",
    "@types/node": "24.0.2",
    "@typescript-eslint/eslint-plugin": "8.34.0",
    "@typescript-eslint/parser": "8.34.0",
    "ajv": "8.17.1",
    "codelyzer": "6.0.2",
    "css-loader": "^7.1.4",
    "eslint": "9.29.0",
    "jsdoc-babel": "0.5.0",
    "serve": "^14.2.4",
    "style-loader": "^4.0.0",
    "ts-node": "10.9.2",
    "typescript": "5.8.3"
  },
  "browser": {
    "fs": false,
    "path": false,
    "util": false,
    "crypto": false
  },
  "overrides": {
    "@ngrx/store": {
      "@angular/core": "20.0.3"
    }
  }
}
